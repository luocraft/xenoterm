{
    "name": "xenoterm",
    "version": "1.7.0",
    "description": "Modern SSH Client Desktop Application",
    "main": "dist/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build && node scripts/build-extensions.js",
        "preview": "electron-vite preview",
        "pack": "electron-vite build && node scripts/build-extensions.js && electron-builder --win --dir",
        "dist": "electron-vite build && node scripts/build-extensions.js && node scripts/build.js && node scripts/build-installer.js",
        "build:extensions": "node scripts/build-extensions.js",
        "build:extension": "node scripts/build-extension.js",
        "pack:extension": "node packages/extension-sdk/scripts/pack.js",
        "create-extension": "node packages/extension-sdk/scripts/create-extension.js",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "adm-zip": "^0.5.16",
        "electron-updater": "^6.8.3",
        "fast-xml-parser": "^5.3.6",
        "koffi": "^2.15.1",
        "qrcode": "^1.5.4",
        "serialport": "^13.0.0",
        "ssh2": "^1.15.0",
        "uuid": "^9.0.0"
    },
    "build": {
        "appId": "com.xenomai.xenoterm",
        "productName": "XenoTerm",
        "directories": {
            "output": "release"
        },
        "publish": [
            {
                "provider": "generic",
                "url": "https://xenotech.net/downloads"
            }
        ],
        "files": [
            "dist/**/*",
            "package.json"
        ],
        "extraMetadata": {
            "main": "dist/main/index.js"
        },
        "asar": false,
        "asarUnpack": [
            "node_modules/ssh2/**/*",
            "node_modules/serialport/**/*",
            "node_modules/@serialport/**/*",
            "node_modules/koffi/**/*"
        ],
        "npmRebuild": true,
        "extraResources": [
            {
                "from": "help.html",
                "to": "help.html"
            },
            {
                "from": "resources/icon.ico",
                "to": "icon.ico"
            },
            {
                "from": "src/main/services/serial-worker.js",
                "to": "serial-worker/serial-worker.js"
            },
            {
                "from": "node_modules/serialport/",
                "to": "serial-worker/node_modules/serialport/"
            },
            {
                "from": "node_modules/@serialport/",
                "to": "serial-worker/node_modules/@serialport/"
            },
            {
                "from": "resources/can/",
                "to": "can/",
                "filter": [
                    "**/*.dll"
                ]
            },
            {
                "from": "extensions/",
                "to": "extensions/",
                "filter": [
                    "**/manifest.json",
                    "**/dist/**",
                    "**/resources/**"
                ]
            },
            {
                "from": "node_modules/debug/",
                "to": "serial-worker/node_modules/debug/"
            },
            {
                "from": "node_modules/ms/",
                "to": "serial-worker/node_modules/ms/"
            },
            {
                "to": "serial-worker/node_modules/node-gyp-build/",
                "from": "node_modules/node-gyp-build/"
            }
        ],
        "win": {
            "icon": "resources/icon.ico",
            "artifactName": "XenoTerm-Setup-${version}.${ext}",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "perMachine": false,
            "allowElevation": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "XenoTerm",
            "runAfterFinish": true,
            "installerIcon": "resources/icon.ico",
            "uninstallerIcon": "resources/icon.ico",
            "installerSidebar": null,
            "uninstallerSidebar": null
        }
    },
    "devDependencies": {
        "@radix-ui/react-dialog": "^1.0.5",
        "@radix-ui/react-dropdown-menu": "^2.0.6",
        "@radix-ui/react-toast": "^1.1.5",
        "@radix-ui/react-tooltip": "^1.0.7",
        "@testing-library/react": "^14.1.2",
        "@types/node": "^20.10.0",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^18.2.39",
        "@types/react-dom": "^18.2.17",
        "@types/serialport": "^8.0.5",
        "@types/ssh2": "^1.11.19",
        "@types/uuid": "^9.0.7",
        "@xterm/addon-fit": "^0.10.0",
        "@xterm/addon-web-links": "^0.11.0",
        "@xterm/xterm": "^5.5.0",
        "autoprefixer": "^10.4.16",
        "electron": "^28.0.0",
        "electron-builder": "^26.7.0",
        "electron-vite": "^2.0.0",
        "fast-check": "^3.14.0",
        "jsdom": "^23.0.1",
        "postcss": "^8.4.32",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "sharp": "^0.34.5",
        "tailwindcss": "^3.3.6",
        "typescript": "^5.3.2",
        "vite": "^5.0.6",
        "vitest": "^1.1.0",
        "zustand": "^4.4.7"
    }
}
