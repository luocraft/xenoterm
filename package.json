{
  "name": "xenoterm",
  "version": "1.2.0",
  "description": "Modern SSH Client Desktop Application",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --win --dir",
    "dist": "electron-vite build && node scripts/build.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "serialport": "^13.0.0",
    "ssh2": "^1.15.0",
    "uuid": "^9.0.0"
  },
  "build": {
    "appId": "com.xenomai.xenoterm",
    "productName": "XenoTerm",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/ssh2/**/*",
      "node_modules/serialport/**/*",
      "node_modules/@serialport/**/*"
    ],
    "npmRebuild": true,
    "extraResources": [
      {
        "from": "help.html",
        "to": "help.html"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "XenoTerm",
      "runAfterFinish": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerSidebar": null,
      "uninstallerSidebar": null
    }
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@testing-library/react": "^14.1.2",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.39",
    "@types/react-dom": "^18.2.17",
    "@types/serialport": "^8.0.5",
    "@types/ssh2": "^1.11.19",
    "@types/uuid": "^9.0.7",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "autoprefixer": "^10.4.16",
    "electron": "^28.0.0",
    "electron-builder": "^26.7.0",
    "electron-vite": "^2.0.0",
    "fast-check": "^3.14.0",
    "jsdom": "^23.0.1",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.2",
    "vite": "^5.0.6",
    "vitest": "^1.1.0",
    "zustand": "^4.4.7"
  }
}
